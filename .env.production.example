# PRODUCTION ENVIRONMENT CONFIGURATION
NODE_ENV=production
PORT=3001

# Production Database (Replace with your secure Managed DB connection string)
# e.g., postgres://db_user:secure_password@aws-rds-hostname:5432/itsm_prod
DATABASE_URL=postgres://itsm_admin:password@127.0.0.1:5432/itsm_test

# Cryptographic Keys (Generate long cryptographically secure random values)
JWT_SECRET=super-secret-production-key-change-me-128bits
ENCRYPTION_KEY=32-byte-hex-key-for-aes-256-data-encryption

# Enterprise SSO / IdP Configuration (Okta / Entra ID)
SSO_SAML_ENTRYPOINT=https://identityprovider.com/saml/sso
SSO_SAML_ISSUER=itsm-enterprise-saas
SSO_SAML_CERT=MII...

# SCIM 2.0 Identity Provisioning Secrets
SCIM_BEARER_SECRET=generate-secure-token-for-scim-auth

# Payment Gateways (Stripe Live Keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
